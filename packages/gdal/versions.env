# Single source of truth for every input to the build.
#
# Pinning by URL + SHA256 is what makes a tag reproducible: re-running the
# v3.13.2 tag a year from now fetches byte-identical sources. Bumping any
# version here is the entire "upgrade" workflow.

GDAL_VERSION=3.13.2
GDAL_SHA256=1051c33db1d9e6a05907ac07cd06f5ce8ac0658f317c3229774cc2198a6c1252

# Build revision of this distribution for the GDAL version above. Empty for the
# first release of an upstream version; 1, 2, ... for a rebuild that changes how
# GDAL is built -- a new dependency, a toolchain fix -- without changing GDAL
# itself. Reset it to empty whenever GDAL_VERSION moves.
DIST_REVISION=1

PROJ_VERSION=9.8.1
PROJ_SHA256=af5b731c145c1d13c4e3b4eeb7d167e94e845e440f71e3496b4ed8dae0291960

GEOS_VERSION=3.14.1
GEOS_SHA256=3c20919cda9a505db07b5216baa980bacdaa0702da715b43f176fb07eff7e716

# SpatiaLite supplies the ST_* SQL functions GDAL's own SQLite dialect lacks
# (ST_PointOnSurface, ST_Centroid). Its optional deps -- freexl, librttopo,
# libxml2, minizip -- are all disabled; what remains is SQLite/PROJ/GEOS/iconv,
# which this build already produces.
SPATIALITE_VERSION=5.1.0
SPATIALITE_SHA256=43be2dd349daffe016dd1400c5d11285828c22fea35ca5109f21f3ed50605080

# SQLite uses a packed version id in its URL and filename.
SQLITE_VERSION=3.53.4
SQLITE_ARCHIVE_VERSION=3530400
SQLITE_ARCHIVE_YEAR=2026
SQLITE_SHA256=0e9483900e92cd5de8fd48d16bf9200145a61f7fd5be542a5ac81d8a9516eb9c

# Oldest macOS the tarball must run on.
MACOSX_DEPLOYMENT_TARGET=13.0

# The version consumers pin and the release is tagged with: the upstream GDAL
# version, plus the build revision when there is one. Defined here so build.sh
# and the release workflow cannot disagree about it.
DIST_VERSION="${GDAL_VERSION}${DIST_REVISION:+.${DIST_REVISION}}"
