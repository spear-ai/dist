# Single source of truth for every input to the build.
#
# tippecanoe is pinned by commit SHA; its dependencies are pinned by URL +
# SHA256 like every other package here. That asymmetry is deliberate -- see
# README.md, "Pinning by commit SHA".

# felt/tippecanoe publishes no release assets, so there is no upstream tarball
# to hash. The tag is what upstream calls the release; the commit SHA is what
# actually pins it. build.sh clones the tag, then refuses to continue unless
# HEAD is this commit and the source's own version.hpp agrees with the version
# below -- so a moved tag or a stale pin fails at fetch time, not at runtime.
TIPPECANOE_VERSION=2.79.0
TIPPECANOE_COMMIT=68ab8dcc229f95b8b25877697d5e8d66783af503

# zlib is built static rather than linked from the platform. macOS ships
# /usr/lib/libz, but libz.so.1 is not part of glibc, so a dynamic libz would
# add a non-platform entry to the Linux binaries' DT_NEEDED list. ~100 KB of
# object code buys back the "links only platform libraries" property that
# smoke-test.sh asserts, on both platforms, from one recipe.
ZLIB_VERSION=1.3.2
ZLIB_SHA256=bb329a0a2cd0274d05519d61c667c062e06990d72e125ee2dfa8de64f0119d16

# SQLite uses a packed version id in its URL and filename. Same pin and same
# feature defines as packages/gdal, so the sqlite inside a tippecanoe binary
# and the one inside libgdal behave identically.
SQLITE_VERSION=3.53.4
SQLITE_ARCHIVE_VERSION=3530400
SQLITE_ARCHIVE_YEAR=2026
SQLITE_SHA256=0e9483900e92cd5de8fd48d16bf9200145a61f7fd5be542a5ac81d8a9516eb9c

# Oldest macOS the tarball must run on.
MACOSX_DEPLOYMENT_TARGET=13.0
